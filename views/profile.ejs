<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Profile - StudyCart</title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

</head>


<body class="bg-gray-50 min-h-screen">


    <%- include("partials/navbar") %>


    <main class="max-w-4xl mx-auto px-8 py-10">


        <!-- HEADER -->

        <div class="mb-8">

            <h1 class="text-3xl font-bold text-gray-800">
                My Profile
            </h1>

            <p class="text-gray-500 mt-2">
                View your StudyCart account information.
            </p>

        </div>



        <!-- PROFILE CARD -->

        <div
            class="bg-white border border-gray-200 rounded-xl p-8"
        >


            <!-- NAME -->

            <div
                class="pb-6 mb-6 border-b border-gray-100"
            >

                <p class="text-sm text-gray-500">
                    Full Name
                </p>

                <p
                    class="text-xl font-semibold text-gray-800 mt-1"
                >
                    <%= profile.name %>
                </p>

            </div>



            <!-- EMAIL -->

            <div
                class="pb-6 mb-6 border-b border-gray-100"
            >

                <p class="text-sm text-gray-500">
                    Email Address
                </p>

                <p
                    class="text-lg text-gray-800 mt-1"
                >
                    <%= profile.email %>
                </p>

            </div>



            <!-- ACCOUNT TYPE -->

            <div
                class="pb-6 mb-6 border-b border-gray-100"
            >

                <p class="text-sm text-gray-500">
                    Account Type
                </p>

                <div class="mt-2">

                    <% if (profile.role === "admin") { %>

                        <span
                            class="inline-block bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold"
                        >
                            Administrator
                        </span>

                    <% } else { %>

                        <span
                            class="inline-block bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm font-semibold"
                        >
                            Customer
                        </span>

                    <% } %>

                </div>

            </div>



            <!-- MEMBER SINCE -->

            <div
                class="pb-6 mb-6 border-b border-gray-100"
            >

                <p class="text-sm text-gray-500">
                    Member Since
                </p>

                <p
                    class="text-lg text-gray-800 mt-1"
                >
                    <%= new Date(
                        profile.created_at
                    ).toLocaleDateString() %>
                </p>

            </div>



            <!-- ACTIONS -->

            <div class="flex flex-wrap gap-4">

                <a
                    href="/orders"
                    class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold"
                >
                    My Orders
                </a>


                <a
                    href="/shop"
                    class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold"
                >
                    Continue Shopping
                </a>

            </div>


        </div>


    </main>


</body>

</html>