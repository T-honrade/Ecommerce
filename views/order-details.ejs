<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Order Details - StudyCart</title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >
</head>

<body class="bg-gray-50 min-h-screen">

    <%- include("partials/navbar") %>

    <main class="max-w-6xl mx-auto px-6 py-10">

        <!-- PAGE HEADER -->

        <div class="mb-8">

            <a
                href="/orders"
                class="text-green-600 hover:text-green-700 font-medium"
            >
                ← Back to My Orders
            </a>

            <h1 class="text-3xl font-bold text-gray-800 mt-4">
                Order #<%= order.id %>
            </h1>

            <p class="text-gray-500 mt-1">
                Placed on
                <%= new Date(order.created_at).toLocaleString() %>
            </p>

        </div>


        <!-- ORDER STATUS -->

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">

            <div class="flex items-center justify-between mb-8">

                <div>

                    <h2 class="text-xl font-bold text-gray-800">
                        Order Status
                    </h2>

                    <p class="text-gray-500 mt-1">
                        Track your order below.
                    </p>

                </div>

                <% if (order.status === "Pending") { %>

                    <span class="px-4 py-2 rounded-full bg-yellow-100 text-yellow-700 font-semibold">
                        Pending
                    </span>

                <% } else if (order.status === "Processing") { %>

                    <span class="px-4 py-2 rounded-full bg-blue-100 text-blue-700 font-semibold">
                        Processing
                    </span>

                <% } else if (order.status === "Shipped") { %>

                    <span class="px-4 py-2 rounded-full bg-purple-100 text-purple-700 font-semibold">
                        Shipped
                    </span>

                <% } else if (order.status === "Completed") { %>

                    <span class="px-4 py-2 rounded-full bg-green-100 text-green-700 font-semibold">
                        Completed
                    </span>

                <% } else { %>

                    <span class="px-4 py-2 rounded-full bg-red-100 text-red-700 font-semibold">
                        Cancelled
                    </span>

                <% } %>

            </div>


            <!-- TRACKING -->

            <% if (order.status !== "Cancelled") { %>

                <div class="grid grid-cols-4 gap-4">

                    <!-- PENDING -->

                    <div class="text-center">

                        <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-green-600 text-white font-bold">
                            ✓
                        </div>

                        <p class="font-semibold text-gray-800 mt-3">
                            Order Placed
                        </p>

                    </div>


                    <!-- PROCESSING -->

                    <div class="text-center">

                        <% if (
                            order.status === "Processing" ||
                            order.status === "Shipped" ||
                            order.status === "Completed"
                        ) { %>

                            <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-green-600 text-white font-bold">
                                ✓
                            </div>

                        <% } else { %>

                            <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-gray-200 text-gray-500 font-bold">
                                2
                            </div>

                        <% } %>

                        <p class="font-semibold text-gray-800 mt-3">
                            Processing
                        </p>

                    </div>


                    <!-- SHIPPED -->

                    <div class="text-center">

                        <% if (
                            order.status === "Shipped" ||
                            order.status === "Completed"
                        ) { %>

                            <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-green-600 text-white font-bold">
                                ✓
                            </div>

                        <% } else { %>

                            <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-gray-200 text-gray-500 font-bold">
                                3
                            </div>

                        <% } %>

                        <p class="font-semibold text-gray-800 mt-3">
                            Shipped
                        </p>

                    </div>


                    <!-- COMPLETED -->

                    <div class="text-center">

                        <% if (order.status === "Completed") { %>

                            <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-green-600 text-white font-bold">
                                ✓
                            </div>

                        <% } else { %>

                            <div class="mx-auto w-10 h-10 rounded-full flex items-center justify-center bg-gray-200 text-gray-500 font-bold">
                                4
                            </div>

                        <% } %>

                        <p class="font-semibold text-gray-800 mt-3">
                            Completed
                        </p>

                    </div>

                </div>

            <% } else { %>

                <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
                    This order has been cancelled.
                </div>

            <% } %>

        </div>


        <!-- CUSTOMER INFORMATION -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">

                <h2 class="text-xl font-bold text-gray-800 mb-4">
                    Customer Information
                </h2>

                <div class="space-y-3">

                    <div>
                        <p class="text-sm text-gray-500">
                            Name
                        </p>

                        <p class="font-medium text-gray-800">
                            <%= order.customer_name %>
                        </p>
                    </div>

                    <div>
                        <p class="text-sm text-gray-500">
                            Contact Number
                        </p>

                        <p class="font-medium text-gray-800">
                            <%= order.contact_number %>
                        </p>
                    </div>

                    <div>
                        <p class="text-sm text-gray-500">
                            Delivery Address
                        </p>

                        <p class="font-medium text-gray-800">
                            <%= order.delivery_address %>
                        </p>
                    </div>

                </div>

            </div>


            <!-- PAYMENT -->

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">

                <h2 class="text-xl font-bold text-gray-800 mb-4">
                    Payment Information
                </h2>

                <div>

                    <p class="text-sm text-gray-500">
                        Payment Method
                    </p>

                    <p class="font-medium text-gray-800 mt-1">
                        <%= order.payment_method %>
                    </p>

                </div>

            </div>

        </div>


        <!-- ORDER ITEMS -->

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">

            <h2 class="text-xl font-bold text-gray-800 mb-6">
                Order Items
            </h2>

            <div class="space-y-5">

                <% items.forEach(item => { %>

                    <div class="flex items-center justify-between border-b border-gray-100 pb-5">

                        <div class="flex items-center gap-4">

                            <% if (item.image) { %>

                                <img
                                    src="/images/<%= item.image %>"
                                    alt="<%= item.name %>"
                                    class="w-20 h-20 object-cover rounded-lg border"
                                >

                            <% } else { %>

                                <div class="w-20 h-20 bg-gray-100 rounded-lg flex items-center justify-center text-2xl">
                                    📚
                                </div>

                            <% } %>

                            <div>

                                <h3 class="font-semibold text-gray-800">
                                    <%= item.name %>
                                </h3>

                                <p class="text-gray-500 mt-1">
                                    ₱<%= Number(item.price).toFixed(2) %>
                                    ×
                                    <%= item.quantity %>
                                </p>

                            </div>

                        </div>

                        <p class="font-bold text-gray-800">
                            ₱<%= (
                                Number(item.price) *
                                Number(item.quantity)
                            ).toFixed(2) %>
                        </p>

                    </div>

                <% }) %>

            </div>


            <!-- TOTAL -->

            <div class="flex justify-between items-center pt-6 mt-6 border-t border-gray-200">

                <span class="text-xl font-bold text-gray-800">
                    Total
                </span>

                <span class="text-2xl font-bold text-green-600">
                    ₱<%= Number(order.total_amount).toFixed(2) %>
                </span>

            </div>

        </div>

    </main>

</body>

</html>
