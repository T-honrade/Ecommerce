<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= product.name %> - StudyCart
    </title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

</head>


<body class="bg-gray-50 min-h-screen">


    <%- include("partials/navbar") %>


    <main class="max-w-6xl mx-auto px-8 py-10">


        <!-- BACK -->

        <div class="mb-6">

            <a
                href="/shop"
                class="text-green-600 hover:text-green-700 font-semibold"
            >
                ← Back to Shop
            </a>

        </div>



        <!-- PRODUCT DETAILS -->

        <div
            class="bg-white border border-gray-200 rounded-xl overflow-hidden"
        >

            <div
                class="grid grid-cols-1 md:grid-cols-2"
            >


                <!-- PRODUCT IMAGE -->

                <div
                    class="bg-gray-50 min-h-[500px] flex items-center justify-center p-10"
                >

                    <% if (product.image) { %>

                        <img
                            src="/images/products/<%= product.image %>"
                            alt="<%= product.name %>"
                            class="w-full h-[450px] object-contain"
                        >

                    <% } else { %>

                        <div
                            class="w-full h-[450px] flex items-center justify-center"
                        >

                            <span class="text-gray-400">
                                No Image Available
                            </span>

                        </div>

                    <% } %>

                </div>



                <!-- PRODUCT INFORMATION -->

                <div class="p-10">


                    <!-- CATEGORY -->

                    <p
                        class="text-green-600 font-semibold text-sm"
                    >
                        <%= product.category_name %>
                    </p>



                    <!-- NAME -->

                    <h1
                        class="text-4xl font-bold text-gray-800 mt-2"
                    >
                        <%= product.name %>
                    </h1>



                    <!-- PRICE -->

                    <p
                        class="text-3xl font-bold text-gray-800 mt-6"
                    >
                        ₱<%= Number(product.price).toFixed(2) %>
                    </p>



                    <!-- DESCRIPTION -->

                    <div class="mt-8">

                        <h2
                            class="text-lg font-bold text-gray-800"
                        >
                            Description
                        </h2>

                        <p
                            class="text-gray-600 mt-2 leading-relaxed"
                        >
                            <%= product.description %>
                        </p>

                    </div>



                    <!-- STOCK -->

                    <div class="mt-6">

                        <% if (product.stock > 0) { %>

                            <p
                                class="text-green-600 font-semibold"
                            >
                                In Stock
                            </p>

                            <p
                                class="text-gray-500 text-sm mt-1"
                            >
                                <%= product.stock %> item(s) available
                            </p>

                        <% } else { %>

                            <p
                                class="text-red-500 font-semibold"
                            >
                                Out of Stock
                            </p>

                        <% } %>

                    </div>



                    <!-- ADD TO CART -->

                    <% if (product.stock > 0) { %>

                        <form
                            action="/cart/add"
                            method="POST"
                            class="mt-8"
                        >

                            <input
                                type="hidden"
                                name="productId"
                                value="<%= product.id %>"
                            >


                            <div class="flex items-end gap-4">


                                <div>

                                    <label
                                        for="quantity"
                                        class="block text-sm font-semibold text-gray-700 mb-2"
                                    >
                                        Quantity
                                    </label>

                                    <input
                                        type="number"
                                        id="quantity"
                                        name="quantity"
                                        value="1"
                                        min="1"
                                        max="<%= product.stock %>"
                                        class="w-24 border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                                    >

                                </div>


                                <button
                                    type="submit"
                                    class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold"
                                >
                                    Add to Cart
                                </button>


                            </div>

                        </form>

                    <% } else { %>

                        <button
                            type="button"
                            disabled
                            class="mt-8 bg-gray-300 text-gray-500 px-6 py-3 rounded-lg font-semibold cursor-not-allowed"
                        >
                            Out of Stock
                        </button>

                    <% } %>


                </div>


            </div>

        </div>


    </main>


</body>

</html>