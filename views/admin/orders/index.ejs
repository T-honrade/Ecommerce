<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Orders - StudyCart</title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

</head>

<body class="bg-gray-50 min-h-screen">

    <!-- NAVBAR -->

    <%- include("../../partials/navbar") %>


    <!-- MAIN -->

    <main class="max-w-7xl mx-auto px-8 py-10">


        <!-- HEADER -->

        <div class="flex items-center justify-between mb-8">

            <div>

                <h1 class="text-3xl font-bold text-gray-800">
                    Manage Orders
                </h1>

                <p class="text-gray-500 mt-2">
                    View and manage customer orders.
                </p>

            </div>

            <a
                href="/admin/dashboard"
                class="text-green-600 hover:text-green-700 font-medium"
            >
                ← Back to Dashboard
            </a>

        </div>


        <!-- ORDERS TABLE -->

        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

            <% if (orders.length === 0) { %>

                <!-- EMPTY -->

                <div class="p-12 text-center">

                    <h2 class="text-xl font-bold text-gray-700">
                        No Orders Yet
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Customer orders will appear here.
                    </p>

                </div>

            <% } else { %>

                <div class="overflow-x-auto">

                    <table class="w-full">

                        <thead class="bg-gray-50 border-b border-gray-200">

                            <tr>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                    Order
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                    Customer
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                    Date
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                    Total
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                    Status
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y divide-gray-100">

                            <% orders.forEach(order => { %>

                                <tr class="hover:bg-gray-50">

                                    <!-- ORDER NUMBER -->

                                    <td class="px-6 py-5">

                                        <p class="font-semibold text-gray-800">
                                            #<%= order.id %>
                                        </p>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td class="px-6 py-5">

                                        <p class="font-medium text-gray-800">
                                            <%= order.customer_name %>
                                        </p>

                                        <p class="text-sm text-gray-500">
                                            <%= order.email %>
                                        </p>

                                    </td>


                                    <!-- DATE -->

                                    <td class="px-6 py-5 text-gray-600">

                                        <%= new Date(
                                            order.created_at
                                        ).toLocaleDateString() %>

                                    </td>


                                    <!-- TOTAL -->

                                    <td class="px-6 py-5">

                                        <p class="font-semibold text-gray-800">
                                            ₱<%= Number(
                                                order.total_amount
                                            ).toFixed(2) %>
                                        </p>

                                    </td>


                                    <!-- STATUS -->

                                    <td class="px-6 py-5">

                                        <% if (order.status === "Pending") { %>

                                            <span class="inline-block px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-sm font-semibold">
                                                Pending
                                            </span>

                                        <% } else if (order.status === "Processing") { %>

                                            <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-sm font-semibold">
                                                Processing
                                            </span>

                                        <% } else if (order.status === "Shipped") { %>

                                            <span class="inline-block px-3 py-1 rounded-full bg-purple-100 text-purple-700 text-sm font-semibold">
                                                Shipped
                                            </span>

                                        <% } else if (order.status === "Completed") { %>

                                            <span class="inline-block px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-semibold">
                                                Completed
                                            </span>

                                        <% } else { %>

                                            <span class="inline-block px-3 py-1 rounded-full bg-red-100 text-red-700 text-sm font-semibold">
                                                Cancelled
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTION -->

                                    <td class="px-6 py-5">

                                        <a
                                            href="/admin/orders/<%= order.id %>"
                                            class="text-green-600 hover:text-green-700 font-semibold"
                                        >
                                            View
                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </main>

</body>

</html>