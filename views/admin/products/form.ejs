<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= product ? "Edit Product" : "Add Product" %> - StudyCart
    </title>

    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-100 min-h-screen">

    <%- include("../../partials/navbar") %>

    <main class="max-w-3xl mx-auto px-6 py-10">

        <div class="mb-8">

            <a
                href="/admin/products"
                class="text-green-600 hover:text-green-700 font-medium"
            >
                ← Back to Products
            </a>

            <h1 class="text-3xl font-bold text-gray-800 mt-4">
                <%= product ? "Edit Product" : "Add Product" %>
            </h1>

            <p class="text-gray-500 mt-1">
                <%= product
                    ? "Update the product information."
                    : "Add a new product to StudyCart."
                %>
            </p>

        </div>

        <% if (error) { %>

            <div class="bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded-lg mb-6">
                <%= error %>
            </div>

        <% } %>

        <form
            action="<%= product
                ? '/admin/products/edit/' + product.id
                : '/admin/products/add'
            %>"
            method="POST"
            class="bg-white rounded-xl shadow p-8 space-y-6"
        >

            <!-- Category -->

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Category
                </label>

                <select
                    name="category_id"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                >

                    <option value="">
                        Select a category
                    </option>

                    <% categories.forEach(category => { %>

                        <option
                            value="<%= category.id %>"
                            <%= product &&
                                Number(product.category_id) === Number(category.id)
                                ? "selected"
                                : ""
                            %>
                        >
                            <%= category.name %>
                        </option>

                    <% }); %>

                </select>

            </div>

            <!-- Product Name -->

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Product Name
                </label>

                <input
                    type="text"
                    name="name"
                    value="<%= product ? product.name : '' %>"
                    placeholder="Example: Blue Ballpen"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                >

            </div>

            <!-- Description -->

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Description
                </label>

                <textarea
                    name="description"
                    rows="4"
                    placeholder="Enter product description..."
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                ><%= product && product.description ? product.description : '' %></textarea>

            </div>

            <!-- Price -->

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Price
                </label>

                <input
                    type="number"
                    name="price"
                    step="0.01"
                    min="0"
                    value="<%= product ? product.price : '' %>"
                    placeholder="0.00"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                >

            </div>

            <!-- Stock -->

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Stock
                </label>

                <input
                    type="number"
                    name="stock"
                    min="0"
                    value="<%= product ? product.stock : '' %>"
                    placeholder="0"
                    required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                >

            </div>

            <!-- Image -->

            <div>

                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Image Filename
                </label>

                <input
                    type="text"
                    name="image"
                    value="<%= product ? product.image || '' : '' %>"
                    placeholder="ballpen.jpg"
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                >

                <p class="text-sm text-gray-500 mt-2">
                    We will connect this to product images later.
                </p>

            </div>

            <!-- Buttons -->

            <div class="flex gap-3 pt-4">

                <a
                    href="/admin/products"
                    class="flex-1 text-center border border-gray-300 hover:bg-gray-100 px-5 py-3 rounded-lg font-semibold text-gray-700"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="flex-1 bg-green-600 hover:bg-green-700 text-white px-5 py-3 rounded-lg font-semibold"
                >
                    <%= product ? "Update Product" : "Add Product" %>
                </button>

            </div>

        </form>

    </main>

</body>
</html>