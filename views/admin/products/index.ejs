<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Products - StudyCart Admin</title>

    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-100 min-h-screen">

    <%- include("../../partials/navbar") %>

    <main class="max-w-7xl mx-auto px-6 py-10">

        <div class="flex justify-between items-center mb-8">

            <div>
                <h1 class="text-3xl font-bold text-gray-800">
                    Products
                </h1>

                <p class="text-gray-500 mt-1">
                    Manage StudyCart products.
                </p>
            </div>

            <a
                href="/admin/products/add"
                class="bg-green-600 hover:bg-green-700 text-white px-5 py-3 rounded-lg font-semibold"
            >
                + Add Product
            </a>

        </div>

        <div class="bg-white rounded-xl shadow overflow-hidden">

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-green-50">

                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">
                                ID
                            </th>

                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">
                                Product
                            </th>

                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">
                                Category
                            </th>

                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">
                                Price
                            </th>

                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">
                                Stock
                            </th>

                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody class="divide-y divide-gray-200">

                        <% if (products.length === 0) { %>

                            <tr>
                                <td
                                    colspan="6"
                                    class="px-6 py-10 text-center text-gray-500"
                                >
                                    No products found.
                                </td>
                            </tr>

                        <% } %>

                        <% products.forEach(product => { %>

                            <tr class="hover:bg-gray-50">

                                <td class="px-6 py-4">
                                    <%= product.id %>
                                </td>

                                <td class="px-6 py-4">

                                    <div class="font-semibold text-gray-800">
                                        <%= product.name %>
                                    </div>

                                    <% if (product.description) { %>

                                        <div class="text-sm text-gray-500 mt-1">
                                            <%= product.description %>
                                        </div>

                                    <% } %>

                                </td>

                                <td class="px-6 py-4 text-gray-600">
                                    <%= product.category_name %>
                                </td>

                                <td class="px-6 py-4 font-semibold">
                                    ₱<%= Number(product.price).toFixed(2) %>
                                </td>

                                <td class="px-6 py-4">
                                    <%= product.stock %>
                                </td>

                                <td class="px-6 py-4">

                                    <div class="flex gap-2">

                                        <a
                                            href="/admin/products/edit/<%= product.id %>"
                                            class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-2 rounded-lg text-sm"
                                        >
                                            Edit
                                        </a>

                                        <form
                                            action="/admin/products/delete/<%= product.id %>"
                                            method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this product?');"
                                        >

                                            <button
                                                type="submit"
                                                class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-sm"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</body>
</html>