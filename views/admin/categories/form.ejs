<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= category ? "Edit Category" : "Add Category" %> - StudyCart
    </title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >
</head>

<body class="min-h-screen bg-gray-50">

    <%- include("../../partials/navbar") %>

    <main class="mx-auto max-w-2xl px-6 py-10">

        <div class="rounded-xl bg-white p-8 shadow-sm">

            <h1 class="text-2xl font-bold text-gray-900">

                <%= category ? "Edit Category" : "Add Category" %>

            </h1>

            <p class="mt-2 text-gray-600">
                Enter the category information below.
            </p>

            <% if (error) { %>

                <div class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-600">
                    <%= error %>
                </div>

            <% } %>

            <form
                action="<%= category
                    ? '/admin/categories/edit/' + category.id
                    : '/admin/categories/add'
                %>"
                method="POST"
                class="mt-8 space-y-6"
            >

                <div>

                    <label class="mb-2 block text-sm font-medium text-gray-700">
                        Category Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= category ? category.name : '' %>"
                        required
                        class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-100"
                        placeholder="Example: Writing Materials"
                    >

                </div>

                <div>

                    <label class="mb-2 block text-sm font-medium text-gray-700">
                        Description
                    </label>

                    <textarea
                        name="description"
                        rows="4"
                        class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-100"
                        placeholder="Describe this category..."
                    ><%= category ? category.description || "" : "" %></textarea>

                </div>

                <div class="flex gap-3">

                    <button
                        type="submit"
                        class="rounded-lg bg-green-600 px-5 py-3 font-semibold text-white hover:bg-green-700"
                    >
                        <%= category ? "Update Category" : "Add Category" %>
                    </button>

                    <a
                        href="/admin/categories"
                        class="rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-700 hover:bg-gray-50"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

</body>

</html>