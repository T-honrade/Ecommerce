<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Dashboard - StudyCart</title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

</head>


<body class="bg-gray-50 min-h-screen">


    <!-- NAVBAR -->

    <%- include("../partials/navbar") %>



    <main class="max-w-7xl mx-auto px-8 py-10">


        <!-- HEADER -->

        <div class="mb-10">

            <h1 class="text-3xl font-bold text-gray-800">
                Admin Dashboard
            </h1>

            <p class="text-gray-500 mt-2">
                Manage your StudyCart store.
            </p>

        </div>



        <!-- STATISTICS -->

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10"
        >


            <!-- TOTAL PRODUCTS -->

            <div
                class="bg-white border border-gray-200 rounded-xl p-6"
            >

                <p class="text-gray-500 text-sm">
                    Total Products
                </p>

                <h2
                    class="text-3xl font-bold text-gray-800 mt-2"
                >
                    <%= totalProducts %>
                </h2>

                <a
                    href="/admin/products"
                    class="inline-block mt-4 text-green-600 font-semibold hover:text-green-700"
                >
                    Manage Products →
                </a>

            </div>



            <!-- TOTAL CATEGORIES -->

            <div
                class="bg-white border border-gray-200 rounded-xl p-6"
            >

                <p class="text-gray-500 text-sm">
                    Total Categories
                </p>

                <h2
                    class="text-3xl font-bold text-gray-800 mt-2"
                >
                    <%= totalCategories %>
                </h2>

                <a
                    href="/admin/categories"
                    class="inline-block mt-4 text-green-600 font-semibold hover:text-green-700"
                >
                    Manage Categories →
                </a>

            </div>



            <!-- TOTAL ORDERS -->

            <div
                class="bg-white border border-gray-200 rounded-xl p-6"
            >

                <p class="text-gray-500 text-sm">
                    Total Orders
                </p>

                <h2
                    class="text-3xl font-bold text-gray-800 mt-2"
                >
                    <%= totalOrders %>
                </h2>

                <a
                    href="/admin/orders"
                    class="inline-block mt-4 text-green-600 font-semibold hover:text-green-700"
                >
                    Manage Orders →
                </a>

            </div>



            <!-- PENDING ORDERS -->

            <div
                class="bg-white border border-gray-200 rounded-xl p-6"
            >

                <p class="text-gray-500 text-sm">
                    Pending Orders
                </p>

                <h2
                    class="text-3xl font-bold text-gray-800 mt-2"
                >
                    <%= pendingOrders %>
                </h2>

                <a
                    href="/admin/orders"
                    class="inline-block mt-4 text-green-600 font-semibold hover:text-green-700"
                >
                    View Orders →
                </a>

            </div>


        </div>



        <!-- STORE MANAGEMENT -->

        <div class="mb-6">

            <h2 class="text-2xl font-bold text-gray-800">
                Store Management
            </h2>

            <p class="text-gray-500 mt-1">
                Manage your products, categories, orders, and customers.
            </p>

        </div>



        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
        >


            <!-- PRODUCTS -->

            <a
                href="/admin/products"
                class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-green-500 hover:shadow-md transition"
            >

                <h2 class="text-xl font-bold text-gray-800">
                    Products
                </h2>

                <p class="text-gray-500 mt-2">
                    Add, edit, and manage your school supply products.
                </p>

                <div class="mt-6">

                    <span class="text-green-600 font-semibold">
                        Manage Products →
                    </span>

                </div>

            </a>



            <!-- CATEGORIES -->

            <a
                href="/admin/categories"
                class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-green-500 hover:shadow-md transition"
            >

                <h2 class="text-xl font-bold text-gray-800">
                    Categories
                </h2>

                <p class="text-gray-500 mt-2">
                    Add, edit, and manage product categories.
                </p>

                <div class="mt-6">

                    <span class="text-green-600 font-semibold">
                        Manage Categories →
                    </span>

                </div>

            </a>



            <!-- ORDERS -->

            <a
                href="/admin/orders"
                class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-green-500 hover:shadow-md transition"
            >

                <h2 class="text-xl font-bold text-gray-800">
                    Orders
                </h2>

                <p class="text-gray-500 mt-2">
                    View customer orders and update order status.
                </p>

                <div class="mt-6">

                    <span class="text-green-600 font-semibold">
                        Manage Orders →
                    </span>

                </div>

            </a>



            <!-- CUSTOMERS -->

            <a
                href="/admin/customers"
                class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-green-500 hover:shadow-md transition"
            >

                <h2 class="text-xl font-bold text-gray-800">
                    Customers
                </h2>

                <p class="text-gray-500 mt-2">
                    View and manage registered StudyCart customers.
                </p>

                <div class="mt-6">

                    <span class="text-green-600 font-semibold">
                        Manage Customers →
                    </span>

                </div>

            </a>


        </div>



        <!-- INFORMATION -->

        <div
            class="mt-10 bg-white border border-gray-200 rounded-xl p-6"
        >

            <h2 class="text-xl font-bold text-gray-800">
                Store Management
            </h2>

            <p class="text-gray-500 mt-2">
                Use the sections above to manage products,
                categories, customer orders, and registered customers.
            </p>

        </div>


    </main>


</body>

</html>