<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Checkout - StudyCart</title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

</head>

<body class="bg-gray-50 min-h-screen">

    <%- include("partials/navbar") %>


    <main class="max-w-6xl mx-auto px-6 py-10">

        <!-- Page Header -->

        <div class="mb-8">

            <h1 class="text-3xl font-bold text-gray-800">
                Checkout
            </h1>

            <p class="text-gray-500 mt-2">
                Enter your delivery information to complete your order.
            </p>

        </div>


        <% if (error) { %>

            <div
                class="mb-6 bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-lg"
            >
                <%= error %>
            </div>

        <% } %>


        <form
            action="/checkout"
            method="POST"
        >

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">


                <!-- ================================ -->
                <!-- CUSTOMER INFORMATION -->
                <!-- ================================ -->

                <div class="lg:col-span-2">

                    <div
                        class="bg-white rounded-xl shadow-sm p-6 md:p-8"
                    >

                        <h2
                            class="text-xl font-bold text-gray-800 mb-6"
                        >
                            Delivery Information
                        </h2>


                        <!-- Customer Name -->

                        <div class="mb-5">

                            <label
                                for="customer_name"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="customer_name"
                                name="customer_name"
                                value="<%= user ? user.name : '' %>"
                                placeholder="Enter your full name"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                            >

                        </div>


                        <!-- Contact Number -->

                        <div class="mb-5">

                            <label
                                for="contact_number"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Contact Number
                            </label>

                            <input
                                type="tel"
                                id="contact_number"
                                name="contact_number"
                                placeholder="Enter your contact number"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                            >

                        </div>


                        <!-- Delivery Address -->

                        <div class="mb-5">

                            <label
                                for="delivery_address"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Delivery Address
                            </label>

                            <textarea
                                id="delivery_address"
                                name="delivery_address"
                                rows="4"
                                placeholder="Enter your complete delivery address"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-500"
                            ></textarea>

                        </div>


                        <!-- Payment Method -->

                        <div>

                            <label
                                class="block text-sm font-semibold text-gray-700 mb-3"
                            >
                                Payment Method
                            </label>


                            <div
                                class="border border-green-500 bg-green-50 rounded-lg p-4"
                            >

                                <div class="flex items-center gap-3">

                                    <input
                                        type="radio"
                                        id="cod"
                                        name="payment_method"
                                        value="Cash on Delivery"
                                        checked
                                        class="w-4 h-4 text-green-600"
                                    >

                                    <label
                                        for="cod"
                                        class="font-semibold text-gray-800"
                                    >
                                        Cash on Delivery
                                    </label>

                                </div>

                                <p
                                    class="text-sm text-gray-500 mt-2 ml-7"
                                >
                                    Pay when your order is delivered.
                                </p>

                            </div>

                        </div>


                        <!-- Place Order -->

                        <button
                            type="submit"
                            class="w-full mt-8 bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-semibold transition"
                        >
                            Place Order
                        </button>


                    </div>

                </div>


                <!-- ================================ -->
                <!-- ORDER SUMMARY -->
                <!-- ================================ -->

                <div>

                    <div
                        class="bg-white rounded-xl shadow-sm p-6 sticky top-6"
                    >

                        <h2
                            class="text-xl font-bold text-gray-800 mb-6"
                        >
                            Order Summary
                        </h2>


                        <!-- Products -->

                        <div class="space-y-4">

                            <% cart.forEach(item => { %>

                                <div
                                    class="flex justify-between gap-4"
                                >

                                    <div>

                                        <p
                                            class="font-semibold text-gray-800"
                                        >
                                            <%= item.name %>
                                        </p>

                                        <p
                                            class="text-sm text-gray-500"
                                        >
                                            Qty: <%= item.quantity %>
                                        </p>

                                    </div>

                                    <p
                                        class="font-semibold text-gray-800 whitespace-nowrap"
                                    >
                                        ₱<%= item.subtotal.toFixed(2) %>
                                    </p>

                                </div>

                            <% }); %>

                        </div>


                        <!-- Total -->

                        <div
                            class="border-t border-gray-200 mt-6 pt-5"
                        >

                            <div
                                class="flex justify-between items-center"
                            >

                                <span
                                    class="text-lg font-semibold text-gray-800"
                                >
                                    Total
                                </span>

                                <span
                                    class="text-2xl font-bold text-green-600"
                                >
                                    ₱<%= total.toFixed(2) %>
                                </span>

                            </div>

                        </div>


                        <!-- Back to Cart -->

                        <a
                            href="/cart"
                            class="block text-center mt-5 text-green-600 hover:text-green-700 font-medium"
                        >
                            ← Back to Cart
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </main>

</body>

</html>